# ====================== 服务基础 ======================
# 后端端口
PORT=3000

# 默认大模型（必须是本账号「支持模型列表」中的值）
# 当前账号支持：auto / hy3 / glm-5.2 / glm-5.1 / minimax-m3 / kimi-* / deepseek-v4-* / custom-local:*
# 注意：claude-sonnet-4 / claude-opus-4 等不在列表内，会直接 400，切勿作为默认值。
# 兜底链顺序：请求模型 -> DEFAULT_MODEL -> auto -> glm-5.2 -> hy3 -> deepseek-v4-flash
DEFAULT_MODEL=auto

# Agent 模式：auto=优先SDK失败降级 | sdk=强制SDK | local=纯知识库直答
AGENT_MODE=auto

# 单次模型尝试的首 token 等待上限（毫秒），超时则尝试下一个候选模型
AGENT_TIMEOUT_MS=20000

# 整条模型兜底链的总等待预算（毫秒），避免多模型依次超时叠加成超长挂起
AGENT_CHAIN_BUDGET_MS=45000

# 品牌名
BRAND_NAME=云智科技

# 启动是否写入演示数据（9 条历史会话）
SEED_DEMO=1

# ====================== 管理员鉴权（生产必配）======================
# 登录用户名（默认 admin）
ADMIN_USERNAME=admin

# 登录密码（未设置时由服务端随机生成并打印于启动日志；生产务必显式设置强密码）
ADMIN_PASSWORD=

# 令牌签名密钥：须为固定强随机值（>=16 位）。未设置则每次启动生成临时密钥，
# 重启后所有管理员登录态失效。生产环境务必通过环境变量固化。
ADMIN_TOKEN_SECRET=

# 令牌有效期（秒，默认 7 天）
ADMIN_TOKEN_TTL_SEC=604800

# ====================== 安全与限流 ======================
# 聊天接口限流：每个客户端 IP 在窗口内（RATE_LIMIT_WINDOW_MS）最多 RATE_LIMIT_MAX 次请求
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# CORS 白名单（逗号分隔的来源）。开发默认含 localhost:5173/3000；生产改为你的域名
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 反向代理信任（部署在 Nginx / 网关后设为 1，以便正确提取客户端真实 IP 用于限流与审计）
TRUST_PROXY=0

# 访问日志落盘路径（设置后所有访问与错误写入该文件，自动创建 logs/ 目录）
LOG_FILE=logs/server.log

# 生产环境：设为 production 时由 Express 直接托管前端构建产物 dist/（无需独立静态服务器）
NODE_ENV=development

# ====================== 启用 LLM「Agent」生成能力（可选）======================
# CodeBuddy Agent SDK 需要交互式登录鉴权（账号口令 / 设备码）。
# 在本机终端执行 `npx @tencent-ai/agent-sdk login`（或对应 CLI）完成登录后，
# 服务端首轮真实对话即可使用大模型生成回复；否则自动降级为「知识库直答」，
# 应用其余功能（意图识别 / FAQ 检索 / 转人工 / 历史持久化 / 管理后台）均不受影响。

# ====================== Hack2skill 参赛配置（Cloud Run + Google Cloud）======================
# 本地开发可全部留空（走 SQLite + lexical RAG）；Cloud Run 部署时按需启用。

# GCP 项目（本地用服务账号密钥文件；Cloud Run 上用默认服务账号，无需密钥）
GCP_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json

# Gemini on Vertex AI（对话 + function calling）
# 模型名以账号可用列表为准，常用 gemini-2.5-flash / gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3

# Vertex AI Search（Discovery Engine）：企业知识检索
VERTEX_SEARCH_ENGINE_ID=your-engine-id
VERTEX_SEARCH_LOCATION=global

# 知识检索提供方：vertex=Vertex AI Search | lexical=现有 SQLite RAG（降级开关）
KNOWLEDGE_PROVIDER=lexical

# BigQuery：问答事件流与洞察看板
BIGQUERY_DATASET=hack2skill
BIGQUERY_TABLE=chat_events

# Cloud Run 部署时由平台自动注入 PORT=8080，本地勿设
